REM Copy this file to r2_settings.bat and fill in your Cloudflare R2 details.
REM r2_settings.bat is git-ignored, so your keys never get uploaded to GitHub.
set S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
set S3_BUCKET=rfai-data
set S3_ACCESS_KEY=YOUR_ACCESS_KEY_ID
set S3_SECRET_KEY=YOUR_SECRET_ACCESS_KEY
